#!/usr/bin/env bash
#
# Pre-commit hook: validate skill frontmatter before allowing a commit.
# Enable with:  git config core.hooksPath .githooks
#
# Skip with:    git commit --no-verify   (use sparingly)

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
exec "$repo_root/scripts/validate-skills.sh"
